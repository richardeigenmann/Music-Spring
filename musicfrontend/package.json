{
    "name": "musicfrontend",
    "version": "0.1.17-SNAPSHOT",
    "scripts": {
        "prestart": "node update-version.js",
        "prebuild": "node update-version.js",
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --watch=false --browsers=ChromeHeadless",
        "container:build": "docker build -t musicfrontend .",
        "e2e": "cypress run",
        "cypress:open": "cypress open",
        "lint": "ng lint"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.2.1",
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/forms": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@angular/router": "^22.2.1",
        "angularx-qrcode": "^21.0.5",
        "chart.js": "^4.5.1",
        "express": "^5.2.1",
        "ng2-charts": "^10.0.0",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.1",
        "@angular/cli": "^22.2.1",
        "@angular/compiler-cli": "^22.2.1",
        "@cypress/schematic": "^5.0.0",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "~6.0.0",
        "angular-eslint": "22.5.0",
        "cypress-recurse": "^1.37.2",
        "eslint": "^10.2.1",
        "istanbul-lib-instrument": "^6.0.3",
        "jasmine-core": "~5.9.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "^2.2.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.58.1",
        "vitest": "^5.0.0"
    }
}